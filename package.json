{
  "name": "desijourney-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm --prefix client run dev\" \"npm --prefix backend run dev\"",
    "build": "cd client && npm run build",
    "start": "npm --prefix backend start",
    "install:all": "npm install && npm --prefix client install && npm --prefix backend install"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^11.1.0",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.1",
    "swiper": "^11.1.15",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
