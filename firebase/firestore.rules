rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tours/{tour} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
    match /blogs/{blog} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
    match /gallery/{item} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
    match /reviews/{review} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
    match /users/{userId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    match /bookings/{booking} { allow create: if request.auth != null; allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true); allow update, delete: if request.auth != null && request.auth.token.admin == true; }
    match /contact/{entry} { allow create: if true; allow read, update, delete: if request.auth != null && request.auth.token.admin == true; }
  }
}
